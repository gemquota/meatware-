{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meatware Task Registry",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "status_vocabulary",
    "availability_vocabulary",
    "rights_scopes",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "const": "prompt-and-circumstance"
    },
    "repository": {
      "const": "gemquota/meatware-"
    },
    "status_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "availability_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rights_scopes": {
      "type": "array",
      "items": {
        "enum": [
          "feedback_only",
          "gated_creative_work"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "status",
        "availability",
        "tier",
        "effort_minutes",
        "spec_path",
        "output_path",
        "output",
        "issue_url",
        "source_paths",
        "depends_on",
        "rights_scope",
        "human_review_required",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "tier": {
          "type": "array",
          "items": {
            "enum": [
              "1",
              "2"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "effort_minutes": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "spec_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rights_scope": {
          "enum": [
            "feedback_only",
            "gated_creative_work"
          ]
        },
        "human_review_required": {
          "type": "boolean"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
